generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model abandoned_carts {
  id            String    @id @default(uuid())
  customerName  String?
  customerPhone String
  cartItems     String
  totalAmount   Decimal   @db.Decimal(10, 2)
  recovered     Boolean?  @default(false)
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt
}

model activity_logs {
  id        String    @id @default(uuid())
  userName  String
  userRole  String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime? @default(now())
}

model banner_cms {
  id         String    @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  linkUrl    String?
  bannerType String
  isActive   Boolean?  @default(true)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt
}

model categories {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  productCount Int?      @default(0)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt
}

model coupons {
  id         String    @id @default(uuid())
  code       String    @unique
  type       String
  value      Decimal   @db.Decimal(10, 2)
  minSpend   Decimal?  @default(0.00) @db.Decimal(10, 2)
  usageLimit Int?      @default(100)
  usedCount  Int?      @default(0)
  expiryDate DateTime
  status     String?   @default("active")
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt
}

model customers {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String    @unique
  totalOrders Int?      @default(0)
  totalSpent  Decimal?  @default(0.00) @db.Decimal(10, 2)
  status      String?   @default("active")
  avatar      String?
  address     String?
  joinedAt    DateTime? @default(now())
  updatedAt   DateTime? @default(now()) @updatedAt
}

model inventory_logs {
  id          String    @id @default(uuid())
  productId   String
  productName String
  change      Int
  type        String
  note        String?
  createdBy   String?   @default("System Admin")
  createdAt   DateTime? @default(now())
}

model order_items {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  image       String
  orders      orders  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model orders {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String?
  customerPhone   String
  shippingAddress String
  city            String?
  postalCode      String?
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal?      @default(0.00) @db.Decimal(10, 2)
  discount        Decimal?      @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          String?       @default("pending")
  paymentStatus   String?       @default("unpaid")
  paymentMethod   String?       @default("COD")
  courierProvider String?
  consignmentId   String?
  trackingCode    String?
  createdAt       DateTime?     @default(now())
  updatedAt       DateTime?     @default(now()) @updatedAt
  order_items     order_items[]
}

model products {
  id                String    @id @default(uuid())
  title             String
  brand             String?
  urlSlug           String    @unique
  sku               String    @unique
  category          String
  buyingPrice       Decimal?  @default(0.00) @db.Decimal(10, 2)
  price             Decimal   @db.Decimal(10, 2)
  comparePrice      Decimal?  @db.Decimal(10, 2)
  stock             Int?      @default(0)
  lowStockThreshold Int?      @default(5)
  status            String?   @default("in_stock")
  image             String
  galleryImages     String?
  keywords          String?
  tags              String?
  shortDescription  String?
  description       String
  features          String?
  specifications    String?
  usability         String?
  boxContent        String?
  color             String?
  material          String?
  warranty          String?
  metaTitle         String?
  metaDescription   String?
  seoKeywords       String?
  deliveryInsideDhaka  Decimal?  @default(70.00) @db.Decimal(10, 2)
  deliveryOutsideDhaka Decimal?  @default(130.00) @db.Decimal(10, 2)
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @default(now()) @updatedAt
}

model sms_logs {
  id        String    @id @default(uuid())
  phone     String
  message   String
  status    String
  gateway   String
  createdAt DateTime? @default(now())
}

model users {
  id          String      @id @default(uuid())
  firebaseUid String?     @unique
  email       String      @unique
  password    String?
  name        String?
  photoUrl    String?
  role        users_role? @default(CUSTOMER)
  createdAt   DateTime?   @default(now())
  updatedAt   DateTime?   @default(now()) @updatedAt
}

enum users_role {
  SUPER_ADMIN
  CLIENT_ADMIN
  CUSTOMER
  STAFF
}
