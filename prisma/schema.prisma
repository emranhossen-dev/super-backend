generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model abandoned_carts {
  id            String    @id @db.VarChar(36)
  customerName  String?   @db.VarChar(255)
  customerPhone String    @db.VarChar(50)
  cartItems     String    @db.LongText
  totalAmount   Decimal   @db.Decimal(10, 2)
  recovered     Boolean?  @default(false)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
  updatedAt     DateTime? @default(now()) @db.DateTime(0)
}

model activity_logs {
  id        String    @id @db.VarChar(36)
  userName  String    @db.VarChar(255)
  userRole  String    @db.VarChar(50)
  action    String    @db.VarChar(100)
  details   String    @db.Text
  ipAddress String?   @db.VarChar(50)
  createdAt DateTime? @default(now()) @db.DateTime(0)
}

model banner_cms {
  id         String    @id @db.VarChar(36)
  title      String    @db.VarChar(255)
  subtitle   String?   @db.VarChar(255)
  imageUrl   String    @db.Text
  linkUrl    String?   @db.VarChar(255)
  bannerType String    @db.VarChar(50)
  isActive   Boolean?  @default(true)
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  updatedAt  DateTime? @default(now()) @db.DateTime(0)
}

model categories {
  id           String    @id @db.VarChar(36)
  name         String    @db.VarChar(255)
  slug         String    @unique(map: "slug") @db.VarChar(255)
  description  String?   @db.Text
  productCount Int?      @default(0)
  createdAt    DateTime? @default(now()) @db.DateTime(0)
  updatedAt    DateTime? @default(now()) @db.DateTime(0)
}

model coupons {
  id         String    @id @db.VarChar(36)
  code       String    @unique(map: "code") @db.VarChar(50)
  type       String    @db.VarChar(50)
  value      Decimal   @db.Decimal(10, 2)
  minSpend   Decimal?  @default(0.00) @db.Decimal(10, 2)
  usageLimit Int?      @default(100)
  usedCount  Int?      @default(0)
  expiryDate DateTime  @db.DateTime(0)
  status     String?   @default("active") @db.VarChar(50)
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  updatedAt  DateTime? @default(now()) @db.DateTime(0)
}

model customers {
  id          String    @id @db.VarChar(36)
  name        String    @db.VarChar(255)
  email       String    @unique(map: "email") @db.VarChar(255)
  phone       String    @unique(map: "phone") @db.VarChar(50)
  totalOrders Int?      @default(0)
  totalSpent  Decimal?  @default(0.00) @db.Decimal(10, 2)
  status      String?   @default("active") @db.VarChar(50)
  avatar      String?   @db.Text
  address     String?   @db.Text
  joinedAt    DateTime? @default(now()) @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @db.DateTime(0)
}

model inventory_logs {
  id          String    @id @db.VarChar(36)
  productId   String    @db.VarChar(36)
  productName String    @db.VarChar(255)
  change      Int
  type        String    @db.VarChar(50)
  note        String?   @db.Text
  createdBy   String?   @default("System Admin") @db.VarChar(255)
  createdAt   DateTime? @default(now()) @db.DateTime(0)
}

model order_items {
  id          String  @id @db.VarChar(36)
  orderId     String  @db.VarChar(36)
  productId   String  @db.VarChar(36)
  productName String  @db.VarChar(255)
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  image       String  @db.Text
  orders      orders  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")

  @@index([orderId], map: "orderId")
}

model orders {
  id              String        @id @db.VarChar(36)
  orderNumber     String        @unique(map: "orderNumber") @db.VarChar(100)
  customerName    String        @db.VarChar(255)
  customerEmail   String?       @db.VarChar(255)
  customerPhone   String        @db.VarChar(50)
  shippingAddress String        @db.Text
  city            String?       @db.VarChar(100)
  postalCode      String?       @db.VarChar(50)
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal?      @default(0.00) @db.Decimal(10, 2)
  discount        Decimal?      @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          String?       @default("pending") @db.VarChar(50)
  paymentStatus   String?       @default("unpaid") @db.VarChar(50)
  paymentMethod   String?       @default("COD") @db.VarChar(50)
  courierProvider String?       @db.VarChar(50)
  consignmentId   String?       @db.VarChar(100)
  trackingCode    String?       @db.VarChar(100)
  createdAt       DateTime?     @default(now()) @db.DateTime(0)
  updatedAt       DateTime?     @default(now()) @db.DateTime(0)
  order_items     order_items[]
}

model products {
  id                String    @id @db.VarChar(36)
  title             String    @db.VarChar(255)
  brand             String?   @db.VarChar(255)
  urlSlug           String    @unique(map: "urlSlug") @db.VarChar(255)
  sku               String    @unique(map: "sku") @db.VarChar(100)
  category          String    @db.VarChar(100)
  buyingPrice       Decimal?  @default(0.00) @db.Decimal(10, 2)
  price             Decimal   @db.Decimal(10, 2)
  comparePrice      Decimal?  @db.Decimal(10, 2)
  stock             Int?      @default(0)
  lowStockThreshold Int?      @default(5)
  status            String?   @default("in_stock") @db.VarChar(50)
  image             String    @db.Text
  galleryImages     String?   @db.LongText
  keywords          String?   @db.LongText
  tags              String?   @db.LongText
  shortDescription  String?   @db.Text
  description       String    @db.LongText
  features          String?   @db.LongText
  specifications    String?   @db.LongText
  usability         String?   @db.Text
  boxContent        String?   @db.LongText
  color             String?   @db.VarChar(100)
  material          String?   @db.VarChar(100)
  warranty          String?   @db.VarChar(100)
  metaTitle         String?   @db.VarChar(255)
  metaDescription   String?   @db.Text
  seoKeywords       String?   @db.LongText
  createdAt         DateTime? @default(now()) @db.DateTime(0)
  updatedAt         DateTime? @default(now()) @db.DateTime(0)
}

model sms_logs {
  id        String    @id @db.VarChar(36)
  phone     String    @db.VarChar(50)
  message   String    @db.Text
  status    String    @db.VarChar(50)
  gateway   String    @db.VarChar(50)
  createdAt DateTime? @default(now()) @db.DateTime(0)
}

model users {
  id          String      @id @db.VarChar(36)
  firebaseUid String?     @unique(map: "firebaseUid") @db.VarChar(255)
  email       String      @unique(map: "email") @db.VarChar(255)
  password    String?     @db.VarChar(255)
  name        String?     @db.VarChar(255)
  photoUrl    String?     @db.VarChar(500)
  role        users_role? @default(CUSTOMER)
  createdAt   DateTime?   @default(now()) @db.DateTime(0)
  updatedAt   DateTime?   @default(now()) @db.DateTime(0)
}

enum users_role {
  SUPER_ADMIN
  CLIENT_ADMIN
  CUSTOMER
  STAFF
}
