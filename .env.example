# Server Port (Default: 5000)
PORT=5000

# Global API Prefix (Default: api/v1)
API_PREFIX=api/v1

# Database URL (PostgreSQL / Neon Connection String)
DATABASE_URL="postgresql://user:password@localhost:5432/website_builder?schema=public"

# Allowed CORS Origins (Comma separated for multiple domains)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# JWT Authentication Secret
JWT_SECRET="your_production_jwt_secret_key_change_me"
JWT_EXPIRES_IN="7d"
